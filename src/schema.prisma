// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Member {
  // Identification and metadata
  id                        Int      @id @default(autoincrement())
  documentID                String   @unique
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Personal information
  name                      String
  gender                    String?
  phone                     String
  birthDate                 DateTime?
  maritalStatus             String?
  address                   String?
  email                     String?
  preferredContactMethod    String?

  // Church and spiritual information
  baptismYear               Int?
  ministry                  String?
  areasToServe              String?
  willingToLead             Boolean?
  suggestions               String?
  pastoralNotes             String?
  currentAcceptanceYear     Int?
  currentAcceptanceMethod   String?
  currentMembershipChurch   String?
  transferAuthorization     Boolean?

  // Professional and educational information
  currentOccupation         String?
  workOrStudyPlace          String?
  professionalArea          String?
  educationLevel            String?
  profession                String?
  workExperience            String?

  // Skills and abilities
  technicalSkills           String?
  softSkills                String?
  languages                 String?

  // Health and special needs
  medicalConditions         String?
  specialNeeds              String?

  // Other useful information
  interestsHobbies          String?
  volunteeringAvailability  String?

  // Relations
  childGuardians         ChildGuardian[]         @relation("ChildGuardians")
  volunteerRegistrations VolunteerRegistration[] @relation("VolunteerRegistrations")
  healthProfile          HealthProfile?          @relation("MemberHealthProfile")
  adultEnrollments       ProgramAdultEnrollment[] @relation("AdultEnrollments")
  enrolledChildren       Enrollment[]            @relation("EnrolledChildren")
}

model FriendRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  address   String?
  note      String?
  reason    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  announcementDate DateTime
  department  String?  // Department code (e.g., "ministerio-infantil-adolescente")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([announcementDate])
  @@index([isActive])
}

// Program/Event information
model Program {
  id          Int      @id @default(autoincrement())
  title       String   // e.g., "Club de Aventureros 2024"
  department  String   // e.g., "club-aventureros"
  content     String?  // Optional: details, directors, organizers, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  enrollments      Enrollment[]
  adultEnrollments ProgramAdultEnrollment[]

  @@index([department])
  @@index([isActive])
}

// Child information
model Child {
  id            Int      @id @default(autoincrement())
  name          String
  documentID    String   @unique // Required for autocomplete functionality
  gender        String?
  birthDate     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  enrollments   Enrollment[] @relation("ChildEnrollments")
  guardians     ChildGuardian[]
  healthProfile HealthProfile? @relation("ChildHealthProfile")

  @@index([createdAt])
  @@index([documentID])
}

// Child-Guardian relationship table
model ChildGuardian {
  id            Int      @id @default(autoincrement())
  childId       Int
  memberId      Int
  relationship  String   // "father", "mother", "guardian", "representative"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  child         Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  member        Member   @relation("ChildGuardians", fields: [memberId], references: [id])

  @@unique([childId, relationship])
  @@index([childId])
  @@index([memberId])
  @@index([relationship])
}

// Enrollment system
model Enrollment {
  id          Int      @id @default(autoincrement())
  programId   Int      // Reference to the program/event
  childId     Int      // Required - programs are for children only

  physicalFormReceivedAt DateTime? // signed authorization printout received
  enrolledByMemberId     Int?      // which tutor registered the child

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  program     Program  @relation(fields: [programId], references: [id])
  child       Child    @relation("ChildEnrollments", fields: [childId], references: [id])
  enrolledBy  Member?  @relation("EnrolledChildren", fields: [enrolledByMemberId], references: [id])

  @@unique([programId, childId])
  @@index([programId])
  @@index([childId])
  @@index([createdAt])
}

// Health record: one per person (child XOR member), program-independent.
model HealthProfile {
  id       Int  @id @default(autoincrement())
  childId  Int? @unique
  memberId Int? @unique

  bloodType   String?
  eps         String?
  allergies   String?
  conditions  String?
  medications String?

  photoUrl      String?
  idDocumentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child  Child?  @relation("ChildHealthProfile", fields: [childId], references: [id], onDelete: Cascade)
  member Member? @relation("MemberHealthProfile", fields: [memberId], references: [id], onDelete: Cascade)
}

// Adult participation in a program's family enrollment. The adult's consent
// covers the children they register.
model ProgramAdultEnrollment {
  id           Int     @id @default(autoincrement())
  programId    Int
  memberId     Int
  role         String  @default("tutor") // legacy, unused (relationship replaced it)
  relationship String? // father | mother | tutor (the adult's relation to the children)

  dataTreatmentAcceptedAt  DateTime?
  participationConfirmedAt DateTime?
  physicalFormReceivedAt   DateTime?

  // Family-group emergency contact (denormalized across the group's adults)
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  member  Member  @relation("AdultEnrollments", fields: [memberId], references: [id])

  @@unique([programId, memberId])
  @@index([programId])
  @@index([memberId])
}

// Volunteer Event information
model VolunteerEvent {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  eventDate     DateTime
  services      String?  // JSON array of available services
  maxCapacities String?  // JSON array of max capacities corresponding to services
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  whatsappGroupUrl String?  // Optional WhatsApp group invite URL

  // Relations
  registrations VolunteerRegistration[]
  healthSurveys HealthSurvey[]

  @@index([eventDate])
  @@index([isActive])
  @@index([createdAt])
}

// Volunteer Registration information
model VolunteerRegistration {
  id               Int      @id @default(autoincrement())
  volunteerEventId Int
  memberDocumentID String   // Document ID to search for member
  memberId         Int?     // Optional reference to Member (can be null)
  selectedService  String
  hasTransport     Boolean  @default(false)
  transportSlots   Int?     // Number of available seats if hasTransport = true
  dietType         String   @default("normal") // "normal" or "vegetariana"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  event   VolunteerEvent @relation(fields: [volunteerEventId], references: [id], onDelete: Cascade)
  member  Member?        @relation("VolunteerRegistrations", fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([volunteerEventId, memberDocumentID])
  @@index([volunteerEventId])
  @@index([memberDocumentID])
  @@index([memberId])
  @@index([createdAt])
}

// Course information (open courses for anyone)
model Course {
  id          Int       @id @default(autoincrement())
  title       String    // Course title
  slug        String    @unique // URL-friendly identifier
  description String    // Brief description for cards/listing
  content     String    // Markdown with full details (instructor, dates, location, etc.)
  imageUrl    String?   // Image URL for social media sharing
  color       String    @default("#4b207f") // Custom color for the course
  cost        Float     @default(0) // Course cost (0 = free)
  startDate   DateTime? // Course start date
  endDate     DateTime? // Course end date
  capacity         Int?      // Maximum capacity (optional)
  whatsappGroupUrl String?   // Optional WhatsApp group invite URL
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  enrollments CourseEnrollment[]

  @@index([slug])
  @@index([isActive])
  @@index([createdAt])
}

// Course Enrollment (open enrollment for anyone)
model CourseEnrollment {
  id              Int      @id @default(autoincrement())
  courseId        Int
  documentNumber  String   // ID document number
  fullName        String   // Full name
  phone           String   // Phone number (WhatsApp contact)
  birthDate       DateTime // Birth date
  isMember        Boolean  @default(false) // Is member of Seventh-day Adventist Church
  paymentProofUrl String?  // Payment proof URL (if cost > 0)
  status          String   @default("pending") // pending, confirmed, rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, documentNumber]) // One person can only enroll once per course
  @@index([courseId])
  @@index([documentNumber])
  @@index([status])
  @@index([createdAt])
}


model HealthSurvey {

  id               Int      @id @default(autoincrement())
  volunteerEventId Int

  // Own conditions (marked with an "X" on the printed sheet)
  hasDiabetes           Boolean @default(false)
  hasHighBloodPressure  Boolean @default(false)
  hasHeartDisease       Boolean @default(false)
  hasHighCholesterol    Boolean @default(false)
  hasOverweight         Boolean @default(false)
  hasDepression         Boolean @default(false)
  otherCondition        String?

  // Family history
  familyHistory       Boolean? // null = unanswered
  familyHistoryDetail String?

  // Habits
  drinksWater          Boolean?
  exercises            Boolean?
  eatsFruitsVegetables Boolean?
  sleepsEightHours     Boolean?
  attendsCheckups      Boolean?
  checkupsDetail       String?

  // Interest in courses and talks
  wantsHealthyHabitsCourse   Boolean?
  wantsHealthTalk            Boolean?
  wantsHealthyCookingCourse  Boolean?
  wantsEmotionalHealthCourse Boolean?
  wantsPersonalFinanceCourse Boolean?

  // Open questions about the neighborhood
  neighborhoodIssue       String?
  neighborhoodImprovement String?

  // Contact data
  name         String
  phone        String
  age          Int?
  neighborhood String?
  address      String?

  acceptsDataTreatment Boolean? // Ley 1581 consent; required to store the row

  capturedBy String? // Cloudflare Access email of the device that captured it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event VolunteerEvent @relation(fields: [volunteerEventId], references: [id], onDelete: Cascade)

  @@index([volunteerEventId])
  @@index([createdAt])
  @@index([phone])
}
