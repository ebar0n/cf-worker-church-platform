{
  "name": "cf-worker-birthday-invitation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "prisma generate --schema src/schema.prisma && opennextjs-cloudflare build",
    "cf:secrets": "wrangler secret bulk .dev.vars",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:generate": "prisma generate --schema src/schema.prisma",
    "db:migrate": "npx wrangler d1 migrations apply church-jordan",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@prisma/adapter-d1": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-checkbox": "1.3.1",
    "@radix-ui/react-label": "2.1.6",
    "@radix-ui/react-radio-group": "1.3.6",
    "@radix-ui/react-slot": "1.2.2",
    "@uiw/react-md-editor": "4.0.8",
    "chart.js": "4.4.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.503.0",
    "next": "16.2.10",
    "pdf-lib": "1.17.1",
    "react": "19.2.7",
    "react-chartjs-2": "5.3.0",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@next/eslint-plugin-next": "15.3.2",
    "@opennextjs/cloudflare": "1.20.1",
    "@tailwindcss/postcss": "4.1.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.17.46",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.20.2",
    "eslint": "8.57.1",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "29.1.1",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.5.14",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  },
  "packageManager": "yarn@3.6.4"
}
